# Copy to .env for local development. Never commit real secrets.
DL360_ENV=local
# The app connects as the restricted role (RLS applies); migrations as the owner.
DL360_DATABASE_URL=postgresql+asyncpg://dl360_app:dl360_app@localhost:5436/dl360
DL360_MIGRATION_DATABASE_URL=postgresql+asyncpg://dl360:dl360@localhost:5436/dl360
DL360_REDIS_URL=redis://localhost:6380/0
DL360_BASE_DOMAIN=digitallearning360.localhost
# Must match apps/web/.env.local
DL360_PROXY_KEY=dev-proxy-key-change-me
# DL360_RESEND_API_KEY=
# DL360_SENTRY_DSN=
